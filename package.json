{
  "name": "bbebee",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "description": "A plugin-based cross-platform music player. See docs/",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "build": "pnpm -r --filter './packages/**' build",
    "typecheck": "pnpm -r typecheck",
    "test": "vitest run",
    "test:watch": "vitest",
    "lint": "eslint .",
    "clean": "pnpm -r exec rm -rf dist *.tsbuildinfo",
    "gen:plugins": "node --experimental-strip-types packages/tooling-gen-plugins/src/cli.ts"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^22.10.2",
    "eslint": "^9.17.0",
    "typescript": "5.9.3",
    "typescript-eslint": "^8.19.0",
    "vitest": "^4.1.11"
  }
}
