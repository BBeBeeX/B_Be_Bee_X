{
  "name": "bbebee",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "description": "A plugin-based cross-platform music player. See docs/",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "check": "pnpm typecheck && pnpm lint && pnpm test",
    "check:changed": "node --experimental-strip-types packages/tooling/tooling-check-changed/src/cli.ts",
    "typecheck": "pnpm -r typecheck",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:ui": "vitest --ui",
    "build": "pnpm -r --filter './packages/**' build",
    "dev:desktop": "pnpm --filter @BBeBee/desktop dev",
    "dev:desktop:debug": "DEBUG=1 pnpm --filter @BBeBee/desktop dev",
    "dev:mobile": "pnpm --filter @BBeBee/mobile start",
    "dev:mobile:debug": "EXPO_PUBLIC_DEBUG=1 pnpm --filter @BBeBee/mobile start",
    "dev:android": "pnpm --filter @BBeBee/mobile android",
    "dev:android:debug": "EXPO_PUBLIC_DEBUG=1 pnpm --filter @BBeBee/mobile android",
    "build:desktop": "pnpm --filter @BBeBee/desktop build",
    "gen:plugins": "node --experimental-strip-types packages/tooling/tooling-gen-plugins/src/cli.ts",
    "new:plugin": "node --experimental-strip-types packages/tooling/tooling-create-plugin/src/cli.ts",
    "clean": "pnpm -r exec rm -rf dist out *.tsbuildinfo",
    "clean:all": "pnpm -r exec rm -rf dist out *.tsbuildinfo node_modules"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@testing-library/react": "^16.3.3",
    "@types/node": "^22.10.2",
    "eslint": "^9.17.0",
    "jsdom": "^30.0.1",
    "typescript": "5.9.3",
    "typescript-eslint": "^8.19.0",
    "vitest": "^4.1.11"
  },
  "dependencies": {
    "quickjs-emscripten": "0.32.0"
  }
}
