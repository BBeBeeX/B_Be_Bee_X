{
  "id": "@BBeBee/plugin-download",
  "version": "0.0.0",
  "displayName": "Playback cache",
  "description": "Caches remote streams as media_bindings and plays the local copy next time.",
  "engines": {
    "BBeBee": "^0.1.0"
  },
  "entry": {
    "main": "./dist/index.js"
  },
  "capabilities": [
    "net:host/*",
    "fs:read:cache",
    "fs:write:cache",
    "db:read:core",
    "db:write:core"
  ]
}
