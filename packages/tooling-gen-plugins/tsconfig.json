{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "rootDir": "src",
    "outDir": "dist",
    // Run directly via `node --experimental-strip-types`, never emitted, so
    // the CLI imports its sibling with an explicit .ts extension.
    "allowImportingTsExtensions": true,
    "noEmit": true
  },
  "include": ["src/**/*"]
}
