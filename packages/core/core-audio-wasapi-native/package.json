{
  "name": "@BBeBee/core-audio-wasapi-native",
  "version": "0.0.0",
  "description": "Native WASAPI Exclusive audio driver and IMMDeviceEnumerator via napi-rs.",
  "type": "module",
  "license": "MIT",
  "exports": {
    ".": "./src/index.ts",
    "./package.json": "./package.json"
  },
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "publishConfig": {
    "exports": {
      ".": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      }
    },
    "main": "./dist/index.js",
    "types": "./dist/index.d.ts"
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "build:native": "cargo build --release",
    "build:native:debug": "cargo build",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "dependencies": {
    "@BBeBee/protocol": "workspace:*"
  },
  "devDependencies": {
    "@BBeBee/kernel": "workspace:*"
  }
}
