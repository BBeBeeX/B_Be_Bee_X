{
  "name": "@BBeBee/ui-parity",
  "version": "0.0.0",
  "description": "The component-parity contract, and the check that both kits meet it.",
  "type": "module",
  "license": "MIT",
  "exports": {
    ".": "./src/index.ts",
    "./package.json": "./package.json"
  },
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "publishConfig": {
    "exports": {
      ".": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      }
    },
    "main": "./dist/index.js",
    "types": "./dist/index.d.ts"
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "dependencies": {
    "@BBeBee/ui-tokens": "workspace:*"
  },
  "devDependencies": {
    "@BBeBee/ui-kit-desktop": "workspace:*",
    "@BBeBee/ui-kit-mobile": "workspace:*",
    "vitest": "^4.1.11"
  }
}
